<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors of our own parts in the dark theme (WPF UI themes its controls itself). -->
    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B0101214" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#C0FFFFFF" />
    <SolidColorBrush x:Key="OverlayDimTextBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="CommandTextBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="CurrentLineBackgroundBrush" Color="#1A60CDFF" />
    <SolidColorBrush x:Key="CommentTextBrush" Color="#6A9955" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#14000000" />
    <SolidColorBrush x:Key="LogSentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="LogPrefixBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="HotendChipBrush" Color="#22FF7043" />
    <SolidColorBrush x:Key="HotendTextBrush" Color="#FFAB91" />
    <SolidColorBrush x:Key="BedChipBrush" Color="#2242A5F5" />
    <SolidColorBrush x:Key="BedTextBrush" Color="#90CAF9" />
    <SolidColorBrush x:Key="ModeBadgeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ModeBadgeTextBrush" Color="#FFFFFF" />
</ResourceDictionary>
