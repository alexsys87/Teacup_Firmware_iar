<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors of our own parts in the light theme (WPF UI themes its controls itself). -->
    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#C0000000" />
    <SolidColorBrush x:Key="OverlayDimTextBrush" Color="#80000000" />
    <SolidColorBrush x:Key="CommandTextBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="CurrentLineBackgroundBrush" Color="#1A005FB8" />
    <SolidColorBrush x:Key="CommentTextBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="LogSentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="LogPrefixBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="HotendChipBrush" Color="#26FF7043" />
    <SolidColorBrush x:Key="HotendTextBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="BedChipBrush" Color="#2642A5F5" />
    <SolidColorBrush x:Key="BedTextBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="ModeBadgeBrush" Color="#22000000" />
    <SolidColorBrush x:Key="ModeBadgeTextBrush" Color="#1F1F1F" />
</ResourceDictionary>
