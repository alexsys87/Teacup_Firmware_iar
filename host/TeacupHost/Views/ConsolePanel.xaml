<UserControl
    x:Class="TeacupHost.Views.ConsolePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border CornerRadius="8" Padding="10" Margin="0,0,0,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <ui:SymbolIcon Symbol="Send24" Margin="0,0,6,0" />
                <TextBlock Text="{DynamicResource S.Console}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="6,3" Icon="{ui:SymbolIcon Delete24}"
                           Content="{DynamicResource S.Clear}" Command="{Binding ClearConsoleCommand}" />
            </DockPanel>
            <WrapPanel Grid.Row="1" Margin="0,4,0,4">
                <CheckBox Content="{DynamicResource S.HideService}" IsChecked="{Binding HideServiceLines}" Margin="0,0,10,0" MinWidth="0"
                          ToolTip="{DynamicResource S.HideServiceTip}" />
                <CheckBox Content="{DynamicResource S.JobLines}" IsChecked="{Binding ShowJobLines}" Margin="0,0,10,0" MinWidth="0" />
                <CheckBox Content="{DynamicResource S.AutoScroll}" IsChecked="{Binding AutoScrollConsole}" MinWidth="0" />
            </WrapPanel>

            <ListBox x:Name="Log" Grid.Row="2" ItemsSource="{Binding LogEntries}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{DynamicResource ConsoleBackgroundBrush}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Time}" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="Prefix" Text="{Binding Prefix}" Width="20" Foreground="{DynamicResource LogPrefixBrush}" />
                            <TextBlock x:Name="Body" Text="{Binding Text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Sent">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource LogSentBrush}" />
                                <Setter TargetName="Prefix" Property="Foreground" Value="{DynamicResource LogSentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Info">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource LogInfoBrush}" />
                                <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource LogWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                <Setter TargetName="Prefix" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="Input" Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{DynamicResource S.ConsolePlaceholder}"
                            FontFamily="{StaticResource MonoFont}" PreviewKeyDown="OnInputKeyDown" />
                <ui:Button Grid.Column="1" Margin="6,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Send24}"
                           Command="{Binding SendConsoleCommand}" ToolTip="{DynamicResource S.Send}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
