<UserControl
    x:Class="TeacupHost.Views.JobPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <!-- File -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.File}" />
                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding FileName, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding FileInfo}" Margin="0,4,0,8" />
                    <ProgressBar Height="4" Margin="0,0,0,8" Minimum="0" Maximum="100" Value="{Binding LoadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel>
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource S.OpenEllipsis}" Command="{Binding OpenFileCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Cube24}" Content="{DynamicResource S.CubeModel}"
                                   Command="{Binding OpenDemoCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.DropHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Print from PC -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.HostPrintTitle}" />
                    <WrapPanel>
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                   Content="{DynamicResource S.TabPrint}" Command="{Binding StartPrintCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Pause24}" Content="{DynamicResource S.Pause}"
                                   Command="{Binding PauseCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon PlayCircle24}" Content="{DynamicResource S.Resume}"
                                   Command="{Binding ResumeCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}"
                                   Content="{DynamicResource S.Stop}" Command="{Binding StopCommand}" />
                    </WrapPanel>
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding PrintProgress, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="12">
                            <Run Text="{Binding PrintSourceText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="·" />
                            <Run Text="{Binding PrintProgress, StringFormat={}{0:0.0}%, Mode=OneWay}" />
                            <LineBreak />
                            <Run Text="{DynamicResource S.Elapsed}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                            <Run Text="{DynamicResource S.RemainingCap}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding RemainingText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{DynamicResource S.HostPrintHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Upload -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.UploadTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding UploadName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PART.GCO"
                                    CharacterCasing="Upper" MaxLength="12" FontFamily="{StaticResource MonoFont}" />
                        <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowUpload24}" Content="{DynamicResource S.Upload}"
                                   Command="{Binding UploadCommand}" />
                    </Grid>
                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding UploadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{DynamicResource S.UploadHint}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
