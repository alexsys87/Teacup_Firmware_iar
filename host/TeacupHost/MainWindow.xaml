<ui:FluentWindow
    x:Class="TeacupHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:TeacupHost.Controls"
    xmlns:v="clr-namespace:TeacupHost.Views"
    xmlns:vm="clr-namespace:TeacupHost.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="Teacup Host"
    Width="1560"
    Height="940"
    MinWidth="1100"
    MinHeight="680"
    AllowDrop="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Teacup Host — управление 3D-принтером">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cube24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================================================ Toolbar -->
        <Border Grid.Row="1" Margin="10,0,10,6" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <!-- Connection -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,8,0" FontSize="18" />
                    <ComboBox Width="180" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                              IsEnabled="{Binding IsDisconnected}" ToolTip="COM-порт принтера" />
                    <ui:Button Margin="4,0,0,0" Padding="8" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshPortsCommand}" ToolTip="Обновить список портов" />
                    <ComboBox Width="110" Margin="6,0,0,0" ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaud}" IsEnabled="{Binding IsDisconnected}"
                              ToolTip="Скорость. Для USB CDC (Black Pill) не важна, для UART — 115200"
                              Visibility="{Binding IsVirtualSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                Visibility="{Binding IsVirtualSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Label}" Text="×" Margin="0,0,4,0" />
                        <ui:NumberBox Width="96" Value="{Binding VirtualTimeScale, Mode=TwoWay}" Minimum="1" Maximum="1000"
                                      SpinButtonPlacementMode="Compact" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                      IsEnabled="{Binding IsDisconnected}"
                                      ToolTip="Во сколько раз виртуальный принтер быстрее настоящего" />
                    </StackPanel>
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}"
                               Content="Подключить" Command="{Binding ConnectCommand}"
                               Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon PlugDisconnected24}" Content="Отключить"
                               Command="{Binding DisconnectCommand}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Status pill -->
                    <Border Margin="12,0,0,0" Padding="10,4" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#33808080" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Online">
                                        <Setter Property="Background" Value="#3322C55E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                        <Setter Property="Background" Value="#33F59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Halted">
                                        <Setter Property="Background" Value="#66EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#9CA3AF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Online">
                                                <Setter Property="Fill" Value="#22C55E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                                <Setter Property="Fill" Value="#F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Halted">
                                                <Setter Property="Fill" Value="#EF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Emergency stop, always at hand -->
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Danger"
                           Icon="{ui:SymbolIcon ErrorCircle24}" Content="СТОП (M112)" FontWeight="Bold"
                           Command="{Binding EmergencyStopCommand}"
                           ToolTip="Аварийный останов: нагреватели и моторы выключаются сразу. Дальше — M999" />
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Cube24}" Content="Демо"
                           Command="{Binding OpenDemoCommand}" ToolTip="Открыть демонстрационную модель" />
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Secondary"
                           Icon="{ui:SymbolIcon FolderOpen24}" Content="Открыть"
                           Command="{Binding OpenFileCommand}" />

                <!-- Temperatures at a glance -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                    <Border Padding="10,3" CornerRadius="6" Background="#22FF7043" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Хотэнд " FontSize="12" Foreground="#FFAB91" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HotendTemp, Converter={StaticResource Temperature}}" FontWeight="SemiBold" />
                            <TextBlock Text=" / " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding HotendTarget, StringFormat={}{0:0}°}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10,3" CornerRadius="6" Background="#2242A5F5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Стол " FontSize="12" Foreground="#90CAF9" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BedTemp, Converter={StaticResource Temperature}}" FontWeight="SemiBold" />
                            <TextBlock Text=" / " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding BedTarget, StringFormat={}{0:0}°}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ Main area -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="420" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: control tabs -->
            <Grid Grid.Column="0" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox x:Name="LeftTabs" Style="{StaticResource SegmentedTabs}" SelectedIndex="0">
                    <ListBoxItem ToolTip="Файл, печать с компьютера, загрузка на SD / flash">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Play24" Style="{StaticResource TabIcon}" />
                            <TextBlock Text="Печать" Style="{StaticResource TabText}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Перемещение осей, экструдер, обдув">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="ArrowMove24" Style="{StaticResource TabIcon}" />
                            <TextBlock Text="Оси" Style="{StaticResource TabText}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Хотэнд, стол, график температур">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Temperature24" Style="{StaticResource TabIcon}" />
                            <TextBlock Text="Нагрев" Style="{StaticResource TabText}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Файлы на SD-карте / SPI flash принтера">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Storage24" Style="{StaticResource TabIcon}" />
                            <TextBlock Text="SD / flash" Style="{StaticResource TabText}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Проверка принтера, остановка, макросы">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Wrench24" Style="{StaticResource TabIcon}" />
                            <TextBlock Text="Тесты" Style="{StaticResource TabText}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <v:JobPanel Visibility="{Binding SelectedIndex, ElementName=LeftTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />
                    <v:ControlPanel Visibility="{Binding SelectedIndex, ElementName=LeftTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                    <v:TemperaturePanel Visibility="{Binding SelectedIndex, ElementName=LeftTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}" />
                    <v:SdPanel Visibility="{Binding SelectedIndex, ElementName=LeftTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}" />
                    <v:ToolsPanel Visibility="{Binding SelectedIndex, ElementName=LeftTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Center: viewer -->
            <v:ViewerPanel x:Name="Viewer" Grid.Column="2" />

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: G-code listing and console -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>
                <v:GCodePanel Grid.Row="0" />
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <v:ConsolePanel Grid.Row="2" />
            </Grid>

            <!-- Notifications -->
            <ui:InfoBar Grid.Column="2" Grid.ColumnSpan="3" Width="440" Margin="0,8,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
                        Title="{Binding NoticeTitle}" Message="{Binding NoticeMessage}"
                        Severity="{Binding NoticeSeverity, Converter={StaticResource Severity}}"
                        IsOpen="{Binding NoticeOpen, Mode=TwoWay}" IsClosable="True"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        </Grid>

        <!-- ============================================================ Status bar -->
        <Border Grid.Row="3" Margin="10,6,10,8" Padding="12,6" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FirmwareName}" FontSize="12" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding PrintSourceText}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  пауза" FontSize="12" Foreground="#F59E0B"
                               Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                      Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PrintProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12">
                        <Run Text="{Binding PrintProgress, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  прошло" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                        <Run Text="  осталось" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding RemainingText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="X" /><Run Text="{Binding PosX, StringFormat={}{0:0.00}, Mode=OneWay}" />
                    <Run Text="  Y" /><Run Text="{Binding PosY, StringFormat={}{0:0.00}, Mode=OneWay}" />
                    <Run Text="  Z" /><Run Text="{Binding PosZ, StringFormat={}{0:0.00}, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
